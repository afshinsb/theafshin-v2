# Frontend-only value. This is safe to expose in the browser bundle.
VITE_TURNSTILE_SITE_KEY="0x4AAAA..."

# Server-side Cloudflare Pages Functions secrets/vars.
# Set these in Cloudflare, not in frontend code.
OPENAI_API_KEY="set-this-as-a-cloudflare-secret"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_MAX_OUTPUT_TOKENS="400"
GEMINI_API_KEY="set-this-as-a-cloudflare-secret-if-translate-is-enabled"
GEMINI_MODEL="gemini-1.5-flash"
ENABLE_TRANSLATE_API="false"
TURNSTILE_SECRET_KEY="set-this-as-a-cloudflare-secret"

# Quotas and rate limits. Tune conservatively for a public portfolio.
CHAT_PER_MINUTE_LIMIT="3"
CHAT_IP_DAILY_LIMIT="5"
CHAT_GLOBAL_DAILY_LIMIT="100"
CONTACT_PER_HOUR_LIMIT="3"
CONTACT_IP_DAILY_LIMIT="5"
TRANSLATE_PER_MINUTE_LIMIT="3"
TRANSLATE_IP_DAILY_LIMIT="5"

# Contact form email delivery via Resend.
RESEND_API_KEY="set-this-as-a-cloudflare-secret"
CONTACT_TO_EMAIL="contact@theafshin.com"
CONTACT_FROM_EMAIL="contact@theafshin.com"
