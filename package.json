{
  "name": "theafshin-portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist/render && node scripts/prerender.mjs",
    "pages:dev": "wrangler pages dev dist/public --kv PORTFOLIO_RATE_LIMIT_KV=00000000000000000000000000000001 --d1 PORTFOLIO_AI_BUDGET=00000000-0000-4000-8000-000000000001 --compatibility-date 2026-11-19 --ip 127.0.0.1 --port 8788",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "audit:public": "node scripts/audit-public.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "wrangler": "^4.165.0"
  }
}
